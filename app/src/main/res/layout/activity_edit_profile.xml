<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btn_back_edit_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Retour"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/green_dark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Modifier le profil"
            android:textColor="@color/green_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Modifiez vos informations personnelles et vos préférences."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- PHOTO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_edit_profile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="Photo de profil"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_photo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Changer la photo"
                android:textColor="@color/green_dark"
                app:cornerRadius="14dp"
                app:strokeColor="@color/green_dark" />

        </LinearLayout>

        <!-- INFORMATIONS -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_first_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Prénom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_first_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_last_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Nom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_last_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_edit_email"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="E-mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_edit_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- OBJECTIF -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Mon objectif"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_edit_objectives"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chip_edit_job"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trouver un premier emploi" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chip_edit_career"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Développer ma carrière" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chip_edit_pleasure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apprendre pour le plaisir" />

        </com.google.android.material.chip.ChipGroup>

        <!-- INTÉRÊTS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mes centres d'intérêt"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_edit_interests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chip_edit_tech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technologie &amp; Dev" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chip_edit_design"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Design &amp; UI/UX" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chip_edit_business"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business &amp; Marketing" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:id="@+id/chip_edit_soft_skills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soft Skills" />

        </com.google.android.material.chip.ChipGroup>

        <!-- NIVEAU -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mon niveau"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_edit_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_edit_beginner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Débutant" />

            <RadioButton
                android:id="@+id/rb_edit_intermediate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intermédiaire" />

            <RadioButton
                android:id="@+id/rb_edit_expert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avancé" />

        </RadioGroup>

        <!-- RYTHME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Mon rythme d'apprentissage"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_edit_pace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/btn_edit_intensive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Intensif" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/btn_edit_moderate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modéré" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/btn_edit_casual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Occasionnel" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ENREGISTRER -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_profile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:text="Enregistrer les modifications"
            android:textColor="@color/white"
            app:backgroundTint="@color/green_primary"
            app:cornerRadius="16dp" />

    </LinearLayout>

</ScrollView>